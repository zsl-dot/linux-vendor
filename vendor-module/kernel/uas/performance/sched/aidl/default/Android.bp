cc_binary {
    name: "vendor.transsion.performance.sched.aidl-service",
    init_rc: ["vendor.transsion.performance.sched.aidl-service.rc"],
    relative_install_path: "hw",
    vintf_fragments: ["trans_sched_device.xml"],
    vendor: true,
    srcs: [
        "Service.cpp",
        "TransSched.cpp",
        ":common_srcs",
    ],
    shared_libs: [
        "libc",
        "liblog",
        "libcutils",
        "libutils",
        "libexpat",
        "libtranlog",
        "libbinder_ndk",
        "libbinder",
        "vendor.transsion.performance.sched.aidl-V2-ndk",
    ],
    local_include_dirs: ["include"],
    include_dirs: ["vendor/transsion/vendor_modules/uas/performance/sched/common"],
}
