// This is the expected build file, but it may not be right in all cases

aidl_interface {
    name: "vendor.transsion.performance.sched.aidl",
    vendor_available: true,
    system_ext_specific: true,
    //host_supported: true,
    srcs: ["vendor/transsion/performance/sched/*.aidl"],
    stability: "vintf",
    owner: "transsion",
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: true,
            platform_apis: true,
            sdk_version: "module_current",
        },
        ndk: {
            enabled: true,
        },
    },
    //frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
        {
            version: "2",
            imports: [],
        },
    ],
}
