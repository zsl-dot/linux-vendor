cc_binary {
    name: "uastool_sys",
    relative_install_path: "hw",

    srcs: ["TransSchedClientTest.cpp"],

    shared_libs: [
        "libc",
        "liblog",
        "libutils",
        "libcutils",
        "libUasClient",
    ],

    header_libs: ["libUasClientHeaders"],
}

cc_binary {
    name: "uastool_vnd",
    vendor: true,
    relative_install_path: "hw",

    srcs: ["TransSchedClientTest.cpp"],

    shared_libs: [
        "libc",
        "liblog",
        "libutils",
        "libcutils",
        "libUasClient",
    ],

    header_libs: ["libUasClientHeaders"],
}
